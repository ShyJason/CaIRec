+class ResidualCompletionAdapter(nn.Module):
+    def __init__(self, input_dim, output_dim, hidden_dim, dropout=0.0):
+        super().__init__()
+        self.skip = nn.Identity() if input_dim == output_dim else nn.Linear(input_dim, output_dim)
