{
    "run_cfg": {
        "default": "./config/pmrl/default_run_cfg.json",
        "learning_rate": 2e-05
    },
    "model_cfg": {
        "default": "./config/pmrl/default_model_cfg.json",
        "vision_encoder_type": "evaclip01_giant"
    },
    "data_cfg": {
        "train": [
            {
                "type": "annoindexed",
                "training": true,
                "name": "audiocaps_train_ret",
                "txt": "./datasets/annotations/audiocaps/audiocaps_train.json",
                "audio": "./audiocaps_train/audio",
                "audio_sample_num": 3,
                "task": "ret%ta",
                "epoch": 8,
                "n_workers": 8,
                "batch_size": 64
            }
        ],
        "val": [
            {
                "type": "annoindexed",
                "training": false,
                "name": "msrvtt_ret",
                "txt": "datasets/annotations/msrvtt/descs_ret_test.json",
                "vision": "MSRVTT/video_test",
                "vision_transforms": "crop_flip",
                "vision_format": "video_rawvideo",
                "audio": "MSRVTT/audio_test",
                "vision_sample_num": 8,
                "audio_sample_num": 1,
                "task": "ret%tvas",
                "n_workers": 8,
                "batch_size": 64
            },
            {
                "type": "annoindexed",
                "training": false,
                "name": "audiocaps_ret",
                "txt": "datasets/annotations/audiocaps/descs_ret_test.json",
                "audio": "./SVD_MM/datasets/audiocaps/audios",
                "vision": "./SVD_MM/datasets/audiocaps/videos",
                "audio_sample_num": 1,
                "vision_format": "video_rawvideo",
                "vision_sample_num": 8,
                "task": "ret%tva",
                "n_workers": 8,
                "batch_size": 64
            }
        ]
    }
}